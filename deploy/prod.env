# Docker 生产环境（215 生产 :9001）
# 一键发布: bash scripts/docker-deploy-prod-all.sh
COMPOSE_PROJECT_NAME=yuce-prod
APP_ENV=production
SERVER_ENV_FILE=./server/.env
# 启用 compose 内 redis
COMPOSE_PROFILES=with-redis

# MySQL 用 server/.env 的 DB_HOST/DB_PORT（145 为外部库）；仅 Redis 走 compose 内网
COMPOSE_REDIS_URL=redis://redis:6379

# 五引擎（server 容器 → 宿主机；先 bash scripts/docker-deploy-services.sh up -d）
SCHEDULER_URL=http://host.docker.internal:9105
COLLECT_URL=http://host.docker.internal:9101
RULES_URL=http://host.docker.internal:9102
BETTING_URL=http://host.docker.internal:9103
STOP_LOSS_URL=http://host.docker.internal:9104

# 宿主机端口（可按机器改；与测试错开，同机可并存）
WEB_PORT=9001
BOARD_PORT=8891
REDIS_HOST_PORT=9016

# 采集用 monitor.env.prod
SOFA_MONITOR_ENV_FILE=monitor.env.prod
