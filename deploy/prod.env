# Docker 生产环境（215 生产 :9001）
# 一键发布: bash scripts/docker-deploy-prod-all.sh
COMPOSE_PROJECT_NAME=yuce-prod
APP_ENV=production
SERVER_ENV_FILE=./server/.env.prod
# 启用 compose 内 redis
COMPOSE_PROFILES=with-redis

# MySQL 用 server/.env.prod 的 DB_*；仅 Redis 走 compose 内网
COMPOSE_REDIS_URL=redis://redis:6379

# 五引擎（server 与 yuce-services 同在 yuce-prod_default 网络，用服务名）
SCHEDULER_URL=http://scheduler:9105
COLLECT_URL=http://collect:9101
RULES_URL=http://rules:9102
BETTING_URL=http://betting:9103
STOP_LOSS_URL=http://stop-loss:9104

# 宿主机端口（可按机器改；与测试错开，同机可并存）
WEB_PORT=9001
BOARD_PORT=8891
DOTA2ELO_PORT=8892
REDIS_HOST_PORT=9016
DOTA2ELO_PRODUCT_URL=http://dota2elo:3001/

# 采集用 monitor.env.prod
SOFA_MONITOR_ENV_FILE=monitor.env.prod
