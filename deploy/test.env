# Docker 测试环境（215 测试 :9018）
# MySQL / Redis：server/.env.test 里用 host.docker.internal → 215 宿主机本机库（勿写公网 IP）
# 一键发布: bash scripts/docker-deploy-test-all.sh
COMPOSE_PROJECT_NAME=yuce-test
APP_ENV=test
SERVER_ENV_FILE=./server/.env.test

# server 容器 → 215 宿主机 MySQL / Redis（覆盖 .env.test 内公网 IP）
COMPOSE_DB_HOST=host.docker.internal
COMPOSE_DB_PORT=3306
COMPOSE_REDIS_URL=redis://host.docker.internal:9015

# 宿主机端口（可按机器改）
WEB_PORT=9018
BOARD_PORT=8890

# 采集用 monitor.env.test（也可不写，靠 APP_ENV=test 自动选）
SOFA_MONITOR_ENV_FILE=monitor.env.test

# 五引擎（测试环境同上）
SCHEDULER_URL=http://host.docker.internal:9105
COLLECT_URL=http://host.docker.internal:9101
RULES_URL=http://host.docker.internal:9102
BETTING_URL=http://host.docker.internal:9103
STOP_LOSS_URL=http://host.docker.internal:9104
