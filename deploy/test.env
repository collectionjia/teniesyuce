# Docker 测试环境（215 测试 :9018）
# MySQL / Redis：见 server/.env.test（215 测试库 46.250.163.215）
# 一键发布: bash scripts/docker-deploy-test-all.sh
COMPOSE_PROJECT_NAME=yuce-test
APP_ENV=test
SERVER_ENV_FILE=./server/.env.test

# server 容器 Redis（测试不启 compose redis）；MySQL 见 server/.env.test
COMPOSE_REDIS_URL=redis://46.250.163.215:9101

# 宿主机端口（可按机器改）
WEB_PORT=9018
BOARD_PORT=8890
DOTA2ELO_PORT=8893
DOTA2ELO_PRODUCT_URL=http://dota2elo:3001/
NFLELO_PORT=8894
NFLELO_URL=http://nflelo:8000

# 采集用 monitor.env.test（也可不写，靠 APP_ENV=test 自动选）
SOFA_MONITOR_ENV_FILE=monitor.env.test

# 五引擎（测试环境：采集避开 Redis:9101，调度避开 tcm-qa:9105）
SCHEDULER_URL=http://host.docker.internal:9115
SCHEDULER_HOST_PORT=9115
COLLECT_URL=http://host.docker.internal:9111
COLLECT_HOST_PORT=9111
RULES_URL=http://host.docker.internal:9102
BETTING_URL=http://host.docker.internal:9103
STOP_LOSS_URL=http://host.docker.internal:9104
