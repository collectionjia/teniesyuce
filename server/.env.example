# 复制为 server/.env 后填写真实值（勿提交 .env）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=tennisv2

JWT_SECRET=change-me-in-production

# 站点
APP_FRONTEND_URL=https://www.yuce.bid
APP_PUBLIC_URL=https://www.yuce.bid
WEB_PORT=9001

# Redis（compose 内网 redis://redis:6379；服务器映射 127.0.0.1:9014，本地经隧道 127.0.0.1:9014）
REDIS_URL=redis://redis:6379
REDIS_PORT=9014

# 支付（按需）
MUSKPAY_API_BASE=https://apitest.nihaopay.com
MUSKPAY_MERCHANT_ID=
MUSKPAY_BEARER_TOKEN=
MUSKPAY_VENDOR=alipay
MUSKPAY_USD_RATE=0.14
MUSKPAY_WEBSITE=https://www.yuce.bid

# BTC board / 链上
ALCHEMY_KEY=
CRAWL_ENABLED=true
FILTER_MARKET_MAKERS=true

# 网球数据采集（宿主机 9004，目录 scripts/tennis-monitor）
SOFA_MONITOR_URL=http://172.17.0.1:9004
SOFA_MONITOR_TOKEN=sofascore-monitor-2026

# 可选：首次初始化管理员
INIT_ADMIN=0
ADMIN_ACCOUNT=
ADMIN_PASSWORD=
ADMIN_NAME=管理员
