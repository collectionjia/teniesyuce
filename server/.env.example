# 复制为 server/.env 后填写真实值（勿提交 .env）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=tennisv2

JWT_SECRET=change-me-in-production

# BTC 钱包私钥加密（独立于 JWT，部署后勿改；未设则回退 JWT_SECRET）
# BTC_WALLET_SECRET=

# 站点
APP_FRONTEND_URL=https://www.yuce.bid
APP_PUBLIC_URL=https://www.yuce.bid
# Docker 对外端口请改 deploy/test.env 或 deploy/prod.env（WEB_PORT / BOARD_PORT / DOTA2ELO_PORT）
# Dota2 Elo 产品内嵌地址（server 容器访问）：DOTA2ELO_PRODUCT_URL=http://dota2elo:3001/
# Dota2 Polymarket 盘口过滤阈值（列表 OR：HC | Elo差 | 强侧胜率）
# DOTA2_ELO_DIFF_MIN=150
# DOTA2_WIN_PROB_MIN=0.65
# DOTA2_PM_COLLECT_MS=90000
# POLY_DOTA_TAG_SLUG=dota-2
# 本地 npm 开发仍用下面占位即可
WEB_PORT=9001

# Redis（Docker 同机部署用 host.docker.internal；本机 npm 连 215 仍用公网 IP；compose 内网 redis://redis:6379）
# 注意：容器内 127.0.0.1 是容器自己，连不上宿主机上的 9015/9016
REDIS_URL=redis://host.docker.internal:9015
REDIS_PORT=9015

# 支付（按需）
MUSKPAY_API_BASE=https://apitest.nihaopay.com
MUSKPAY_MERCHANT_ID=
MUSKPAY_BEARER_TOKEN=
MUSKPAY_VENDOR=alipay
MUSKPAY_USD_RATE=0.14
MUSKPAY_WEBSITE=https://www.yuce.bid

# BTC board / 链上
ALCHEMY_KEY=
CRAWL_ENABLED=true
FILTER_MARKET_MAKERS=true

# 网球 collect.py 目录（管理员采集按钮）
# Docker compose 已挂载 scripts/tennis-monitor → /tennis-monitor，点击采集直接跑 collect.py（无需 9004）
# 本地 npm run dev 可设: TENNIS_MONITOR_DIR=../scripts/tennis-monitor
# 全量采集走 collect.py（curl_cffi + IPWO）；盘中 collect_live.py 默认开启
# TENNIS_PYTHON_COLLECT=0 可关闭盘中 Python 采集
# 盘中迁桶 tick（collect.inplay_tick）默认开；管理页 collect.inplay_tick_enabled 可关
# 网球 inplay Sofascore 比分后台循环（默认开）；SOFA_SCORE_LOOP=0 关闭；SOFA_SCORE_LOOP_MS 默认 30000
# Polymarket 赔率后台循环（默认开，index.js 启动）；POLY_ODDS_LOOP=0 关闭；POLY_ODDS_LOOP_MS 默认 1000

# 网球列表数据源：collect.py 直写 Redis（推荐，无需 9004）
# 设为 1 才恢复旧链路：server 从 tennis-monitor:9004 拉 bundle 再写 Redis
# TENNIS_SYNC_FROM_MONITOR=0

# 管理后台代理 tennis-monitor HTTP（与网球列表 Redis 读取无关）
SOFA_MONITOR_URL=http://127.0.0.1:9004
SOFA_MONITOR_TOKEN=sofascore-monitor-2026

# 五引擎（P6：server 代理，页面走 /api/admin/engines/*）
SCHEDULER_URL=http://127.0.0.1:9105
COLLECT_URL=http://127.0.0.1:9101
RULES_URL=http://127.0.0.1:9102
BETTING_URL=http://127.0.0.1:9103
STOP_LOSS_URL=http://127.0.0.1:9104
# INTERNAL_SERVICE_TOKEN=  # 与 services/* 一致，生产建议设置

# 可选：首次初始化管理员
INIT_ADMIN=0
ADMIN_ACCOUNT=
ADMIN_PASSWORD=
ADMIN_NAME=管理员
