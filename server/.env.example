# 复制为 server/.env 后填写真实值（勿提交 .env）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=tennisv2

JWT_SECRET=change-me-in-production

# 站点
APP_FRONTEND_URL=https://www.yuce.bid
APP_PUBLIC_URL=https://www.yuce.bid
WEB_PORT=9001

# Redis（本地测试用远程 46.250.163.215:9015；compose 内网 redis://redis:6379；服务器 127.0.0.1:9014）
REDIS_URL=redis://46.250.163.215:9015
REDIS_PORT=9015

# 支付（按需）
MUSKPAY_API_BASE=https://apitest.nihaopay.com
MUSKPAY_MERCHANT_ID=
MUSKPAY_BEARER_TOKEN=
MUSKPAY_VENDOR=alipay
MUSKPAY_USD_RATE=0.14
MUSKPAY_WEBSITE=https://www.yuce.bid

# BTC board / 链上
ALCHEMY_KEY=
CRAWL_ENABLED=true
FILTER_MARKET_MAKERS=true

# 网球 collect.py 目录（管理员采集按钮）
# Docker compose 已挂载 scripts/tennis-monitor → /tennis-monitor，点击采集直接跑 collect.py（无需 9004）
# 本地 npm run dev 可设: TENNIS_MONITOR_DIR=../scripts/tennis-monitor

# 网球列表数据源：collect.py 直写 Redis（推荐，无需 9004）
# 设为 1 才恢复旧链路：server 从 tennis-monitor:9004 拉 bundle 再写 Redis
# TENNIS_SYNC_FROM_MONITOR=0

# 管理后台代理 tennis-monitor HTTP（与网球列表 Redis 读取无关）
SOFA_MONITOR_URL=http://127.0.0.1:9004
SOFA_MONITOR_TOKEN=sofascore-monitor-2026

# 可选：首次初始化管理员
INIT_ADMIN=0
ADMIN_ACCOUNT=
ADMIN_PASSWORD=
ADMIN_NAME=管理员
