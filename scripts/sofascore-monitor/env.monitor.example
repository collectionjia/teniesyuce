# Sofascore HTTP client (optional overrides)
SOFA_REQUEST_TIMEOUT_SEC=90
SOFA_REQUEST_RETRIES=3
SOFA_REQUEST_RETRY_BACKOFF_SEC=3

# Live score polling interval (seconds)
LIVE_POLL_INTERVAL_SEC=60

# Proxy for Sofascore API (recommended if direct access is blocked/rate-limited)
# Examples:
#   SOFA_HTTP_PROXY=http://user:pass@127.0.0.1:7890
#   SOFA_HTTPS_PROXY=http://user:pass@127.0.0.1:7890
# Falls back to HTTP_PROXY / HTTPS_PROXY if SOFA_* not set.
SOFA_HTTP_PROXY=
SOFA_HTTPS_PROXY=
