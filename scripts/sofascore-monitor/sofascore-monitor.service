[Unit]
Description=Sofascore tennis monitor (9004)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/yuce/bbbbb/scripts/sofascore-monitor
EnvironmentFile=-/opt/yuce/bbbbb/scripts/sofascore-monitor/monitor.env
ExecStart=/opt/yuce/bbbbb/scripts/sofascore-monitor/venv/bin/python /opt/yuce/bbbbb/scripts/sofascore-monitor/monitor_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target