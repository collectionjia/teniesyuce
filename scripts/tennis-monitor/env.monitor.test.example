# 复制为 scripts/tennis-monitor/monitor.env.test（勿提交）
# Docker 测试: APP_ENV=test 时自动加载本文件

# IPWO：管理中心「采集代理」配置；以下键已废弃
# IPWO_PROXY_HOST=
# IPWO_PROXY_PORT=
# IPWO_PROXY_USER=
# IPWO_PROXY_PASS=
# IPWO_PROXY_ZONE=

SOFA_HTTP_PROXY=
SOFA_HTTPS_PROXY=

SOFA_REQUEST_TIMEOUT_SEC=90
SOFA_REQUEST_RETRIES=3
SOFA_REQUEST_RETRY_BACKOFF_SEC=3
SOFA_MIN_INTERVAL=0.35
LIVE_POLL_INTERVAL_SEC=300

# compose project: yuce-test → 容器名一般为 yuce-test-server-1
YUCE_SERVER_CONTAINER=yuce-test-server-1

SOFA_MONITOR_HOST=0.0.0.0
SOFA_MONITOR_PORT=9004
SOFA_MONITOR_TOKEN=sofascore-monitor-2026

SOFA_WRITE_MYSQL=0

# 215 宿主机本机 Redis（monitor 跑在宿主机时用 127.0.0.1）
REDIS_URL=redis://127.0.0.1:9015
