# IPWO 住宅代理（见 https://docs.ipwo.net/）
# 方式一：分开配置（推荐，与 IPWO 控制台一致）
IPWO_PROXY_HOST=us.ipwo.net
IPWO_PROXY_PORT=7878
IPWO_PROXY_USER=ss1029
IPWO_PROXY_PASS=23456789xxx
# 对应 curl: -U "ss1029_custom_zone_GLOBAL_sid_59147915_time_10:..."
IPWO_PROXY_ZONE=GLOBAL
IPWO_PROXY_SESSION=59147915
IPWO_PROXY_STICKY_MIN=10

# 方式二：完整 URL（会覆盖方式一）
# SOFA_HTTP_PROXY=http://user:pass@us.ipwo.net:7878
# SOFA_HTTPS_PROXY=http://user:pass@us.ipwo.net:7878

SOFA_HTTP_PROXY=
SOFA_HTTPS_PROXY=

# Sofascore API（默认走官网同源，避免 api.sofascore.com 403）
# SOFA_API_BASE=https://www.sofascore.com/api/v1
SOFA_REQUEST_TIMEOUT_SEC=90
SOFA_REQUEST_RETRIES=3
SOFA_REQUEST_RETRY_BACKOFF_SEC=3
SOFA_MIN_INTERVAL=0.35

# Live score polling interval (seconds). t3.small 建议 >=300
LIVE_POLL_INTERVAL_SEC=300

# Docker server 容器名（compose project: yuce）；本地 npm run dev 无容器，可设 none 跳过 docker exec
# YUCE_SERVER_CONTAINER=none
YUCE_SERVER_CONTAINER=yuce-prod-server-1

# Monitor HTTP API
SOFA_MONITOR_HOST=0.0.0.0
SOFA_MONITOR_PORT=9004
SOFA_MONITOR_TOKEN=sofascore-monitor-2026

# MySQL（默认不写库；需入库时设 SOFA_WRITE_MYSQL=1）
SOFA_WRITE_MYSQL=0

# Redis（collect_live → tennis:bundle:inplay，须与 server/.env 一致）
# 生产看板推送：服务器本机 Redis（compose 映射 9016）。本机请用 SSH 隧道 + SOFA_BOARD_REDIS_URL
REDIS_URL=redis://127.0.0.1:9016
SOFA_BOARD_REDIS_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=tennisv2
