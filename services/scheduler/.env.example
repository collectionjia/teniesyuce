PORT=9105

# 与 server 共用库（可复制 server/.env 中 DB_* / REDIS_URL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=tennisv2
REDIS_URL=redis://127.0.0.1:6379

# http | legacy（legacy 调 server 内嵌 runner，仅本机 dev）
EXECUTOR_MODE=http
# SERVER_ROOT=../../server

# 引擎服务 URL（EXECUTOR_MODE=http 时必填）
COLLECT_URL=http://127.0.0.1:9101
RULES_URL=http://127.0.0.1:9102
BETTING_URL=http://127.0.0.1:9103
STOP_LOSS_URL=http://127.0.0.1:9104

INTERNAL_SERVICE_TOKEN=
SCHEDULER_LOOP_ENABLED=1
