# 复制为 board.env 后填写（server.py 只读本目录）
SOFA_BOARD_HOST=127.0.0.1
SOFA_BOARD_PORT=8765

# SofaScore 代理（IP 被拦时填 IPWO）
IPWO_PROXY_HOST=us.ipwo.net
IPWO_PROXY_PORT=7878
IPWO_PROXY_USER=
IPWO_PROXY_PASS=
IPWO_PROXY_ZONE=GLOBAL
IPWO_PROXY_SESSION=
IPWO_PROXY_STICKY_MIN=10
SOFA_HTTP_PROXY=
SOFA_HTTPS_PROXY=

# 本地可选 Redis（一般不用；线上靠 HTTP 推送）
REDIS_URL=
SOFA_BOARD_REDIS_URL=

# 推送到 yuce.bid → 生产 Redis
SOFA_BOARD_PUSH_URL=https://www.yuce.bid
# SOFA_BOARD_PUSH_TOKEN=
# 本地刷新后自动推线上（默认：有 PUSH_URL 则开；关：SOFA_BOARD_AUTO_PUSH=0）
SOFA_BOARD_AUTO_PUSH=1
