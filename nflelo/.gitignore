# Backups generated by run_weekly.py
data/raw/games.*.bak
data/processed/p8_ratings_snapshot.*.bak
# Note: xgb_ensemble.pkl (~57KB) is intentionally tracked in git — it's small,
#      rebuilt deterministically from run_p9.py, and the file is needed by
#      src/api.py + src/predict.py at runtime.
#      If it grows past ~1MB in future versions, switch to git-lfs and add
#      `data/processed/*.pkl filter=lfs diff=lfs merge=lfs -text` to
#      .gitattributes.